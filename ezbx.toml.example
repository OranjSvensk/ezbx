# ezbx.toml.example
# Copy this file to your ezbx config folder as ezbx.toml and edit it:
#   Windows: %LOCALAPPDATA%\ezbx\ezbx.toml
#   macOS:   ~/Library/Application Support/ezbx/ezbx.toml
#   Linux:   ~/.config/ezbx/ezbx.toml
# Or point at it with --config FILE or the EZBX_CONFIG environment variable.
# Unknown settings are refused, so a typo is an error rather than ignored.
#
# Windows paths: use single quotes ('C:\Users\Example\ezbx') or forward
# slashes, because a backslash inside double quotes starts an escape.
version = 1

[box.main]                        # name: lowercase letters, digits and dashes
workspace = '~/ezbx/workspace'    # the ONLY folder the agent can write to
# memory  = "8g"                  # default: half of Docker's memory, from 2g to 8g
# cpus    = 4                     # default: no limit
# pids    = 512                   # process limit, default 512
network   = "off"                 # off | allow | on
# allow   = ["registry.npmjs.org"] # hosts allowed in "allow" mode, besides the harnesses' own
harnesses = ["pi"]                # more are added once their install is verified
tools     = ["pack:coding"]       # built into the box: packs (pack:coding, pack:web,
                                  # pack:media) and single tools, such as "ffmpeg".
                                  # After a change: ezbx build, ezbx down, ezbx up

# Snapshots of the workspace, taken before every ezbx shell (undo with
# ezbx rewind). All optional; these are the defaults.
# [box.main.snapshots]
# skip     = ["node_modules", ".venv", "venv", "__pycache__", ".pytest_cache", ".mypy_cache", ".next", ".cache"]
# max_file = "100m"               # larger files are left out
# keep     = 20                   # automatic snapshots kept; ones taken by hand stay

# Optional: folders the agent may READ but never change, at /readonly/<name>.
# Common secret files (.env, keys, .ssh/ and more) are hidden by default;
# see docs/readonly.md. Give one [[box.main.readonly]] per folder.
# [[box.main.readonly]]
# path   = "~/projects"
# name   = "projects"             # the default: the folder's own name, lowercased
# mask   = ["secrets.yml", "private/"]   # hidden too, on top of the defaults
# unmask = [".npmrc"]             # a default to show after all, written exactly

# The model server on this computer. Any program that serves an
# OpenAI- or Anthropic-compatible API works; ezbx up contacts only this address.
# "ezbx engine detect" lists the servers it finds on the common ports.
[engine]
url     = "http://127.0.0.1:1234"
api     = "auto"                  # auto | openai | lmstudio | anthropic (auto:
                                  # the most specific kind the server answers)
# key_env = "ENGINE_API_KEY"      # NAME of an environment variable holding the key,
#                                 # never the key itself (it is only sent to url)
# host    = "localhost:PORT"      # Host header to send, for servers that check it

# Facts about a model that servers don't report. Use the id from
# "ezbx engine detect".
# [models."big-model"]
# reasoning  = true               # a reasoning model needs this...
# max_tokens = 8192               # ...and room for its answer
# context    = 32768
# name       = "Big model"

[gateway]
log = true                        # keep a request log in the state folder
